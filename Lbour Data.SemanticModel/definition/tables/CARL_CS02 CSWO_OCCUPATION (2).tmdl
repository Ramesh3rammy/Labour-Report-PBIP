	measure 'total time' = ```
			var total_Hours = SUMX('CARL_CS02 CSWO_OCCUPATION (2)',HOUR('CARL_CS02 CSWO_OCCUPATION (2)'[Time])+MINUTE('CARL_CS02 CSWO_OCCUPATION (2)'[Time])/60)
			
			var totalhours = total_Hours
			var hoursint = TRUNC(totalhours)
			var minutestotal = ROUND( (totalhours - hoursint) * 60,0)
			return
			FORMAT(hoursint,"00")&"H,"&FORMAT(minutestotal,"00")&"M"
			
			
